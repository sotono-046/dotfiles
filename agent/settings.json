{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "mcp__serena__activate_project",
      "mcp__serena__list_memories",
      "mcp__serena__read_memory",
      "mcp__serena__find_file",
      "mcp__serena__list_dir",
      "mcp__serena__search_for_pattern",
      "mcp__serena__find_symbol",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__think_about_whether_you_are_done",
      "mcp__serena__think_about_collected_information",
      "Skill(skill-creator)"
    ],
    "deny": [],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git clean *)",
      "Bash(git clean)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(rm -rf *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr merge)",
      "Bash(gh repo delete *)",
      "Bash(gh repo delete)",
      "Bash(gh release *)",
      "Bash(gh release)",
      "Bash(gcloud * delete *)",
      "Bash(gcloud * deploy *)",
      "Bash(gcloud run deploy)",
      "Bash(gcloud functions deploy)",
      "Bash(gcloud run services delete *)",
      "Bash(gcloud functions delete *)",
      "Bash(firebase deploy *)",
      "Bash(firebase deploy)",
      "Bash(pnpm deploy *)",
      "Bash(pnpm deploy)",
      "Bash(sudo *)",
      "Bash(sudo)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Pop.aiff"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notification-discord.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Hero.aiff"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-discord.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start-discord.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-end-discord.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "fairy-tale@fairy-tale-marketplace": true
  },
  "extraKnownMarketplaces": {
    "fairy-tale-marketplace": {
      "source": {
        "source": "github",
        "repo": "bonginkan/fairy_tale"
      }
    }
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "plansDirectory": "./.temp/plans",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": false
}
